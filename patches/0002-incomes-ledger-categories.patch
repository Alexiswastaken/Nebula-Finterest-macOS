diff --git a/src/renderer/components/IncomesPanel.tsx b/src/renderer/components/IncomesPanel.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..9af70c90004c3e1f86e50adeada6750125820216
--- /dev/null
+++ b/src/renderer/components/IncomesPanel.tsx
@@ -0,0 +1,187 @@
+import { useState } from 'react';
+import type { BudgetSnapshot, BudgetSummary, Income, IncomeFrequency } from '@shared/types';
+import { formatLocalDate, parseAmount } from '@shared/budget';
+import type { Language } from '../i18n';
+import { translate } from '../i18n';
+import { categoryNames, formatMoney } from '../constants';
+import { Card, FieldGroup, ListCard } from './atoms';
+import { Icon } from './Icon';
+
+export interface IncomeActions {
+  addIncome: (income: Partial<Income> & { name: string; amount: number }) => Promise<boolean>;
+  toggleIncome: (id: string, active: boolean) => Promise<boolean>;
+  deleteIncome: (id: string) => Promise<boolean>;
+}
+
+interface IncomeFormState {
+  name: string;
+  amount: string;
+  category: string;
+  frequency: IncomeFrequency;
+  date: string;
+  dayOfMonth: string;
+}
+
+const emptyForm = (frequency: IncomeFrequency): IncomeFormState => ({ name: '', amount: '', category: '', frequency, date: formatLocalDate(new Date()), dayOfMonth: '' });
+
+function formatDate(date: string, language: Language): string {
+  const [year, month, day] = date.split('-').map(Number);
+  if (!year || !month || !day) return date;
+  return new Date(year, month - 1, day).toLocaleDateString(language === 'en' ? 'en-US' : 'fr-FR', { day: 'numeric', month: 'short' });
+}
+
+/**
+ * "Revenus": the main monthly income of the settings, plus any number of other incomes, each
+ * either one-off (a date) or recurring (every month, optionally on a given day).
+ */
+export function IncomesPanel({ snapshot, summary, monthKey, language, incomeInput, onIncomeInputChange, onSaveIncome, actions }: {
+  snapshot: BudgetSnapshot;
+  summary: BudgetSummary | null;
+  monthKey: string;
+  language: Language;
+  /** The main monthly income, typed as text (same field as on the overview). */
+  incomeInput: string;
+  onIncomeInputChange: (value: string) => void;
+  onSaveIncome: () => void;
+  actions: IncomeActions;
+}) {
+  const t = (key: Parameters<typeof translate>[1], params?: Record<string, string>) => translate(language, key, params);
+  const [form, setForm] = useState<IncomeFormState>(emptyForm('once'));
+  const [formError, setFormError] = useState<string | null>(null);
+  const incomes = snapshot.incomes ?? [];
+  const recurring = incomes.filter((income) => income.frequency === 'monthly');
+  const oneOff = incomes.filter((income) => income.frequency === 'once' && income.date?.slice(0, 7) === monthKey);
+  const categories = categoryNames(snapshot, 'income', language);
+
+  async function submit(): Promise<void> {
+    const amount = parseAmount(form.amount);
+    const day = form.dayOfMonth.trim() ? Number(form.dayOfMonth) : null;
+    if (!form.name.trim()) {
+      setFormError(t('error.invalidName'));
+      return;
+    }
+    if (!Number.isFinite(amount) || amount < 0) {
+      setFormError(t('error.negativeAmount'));
+      return;
+    }
+    if (form.frequency === 'monthly' && day !== null && (!Number.isInteger(day) || day < 1 || day > 31)) {
+      setFormError(t('error.invalidDate'));
+      return;
+    }
+    setFormError(null);
+    const saved = await actions.addIncome({
+      name: form.name,
+      amount,
+      category: form.category,
+      frequency: form.frequency,
+      date: form.frequency === 'once' ? form.date : null,
+      dayOfMonth: form.frequency === 'monthly' ? day : null,
+      active: true,
+    });
+    if (saved) setForm(emptyForm(form.frequency));
+  }
+
+  return (
+    <>
+      <section className="summary-grid">
+        <Card label={t('incomes.card.base')} value={formatMoney(summary?.baseIncome ?? 0, language)} accent="income" icon="bank" />
+        <Card label={t('incomes.card.recurring')} value={formatMoney(summary?.recurringIncome ?? 0, language)} accent="fixed" icon="repeat" />
+        <Card label={t('incomes.card.oneOff')} value={formatMoney(summary?.oneOffIncome ?? 0, language)} accent="variable" icon="sparkles" />
+        <Card label={t('incomes.card.total')} value={formatMoney(summary?.income ?? 0, language)} accent="remaining" icon="trendUp" tone="positive" />
+      </section>
+
+      <section className="input-panel income-forms">
+        <FieldGroup title={t('incomes.base.title')}>
+          <p className="field-note">{t('incomes.base.hint')}</p>
+          <label>
+            {t('form.income.label')}
+            <input aria-label={t('incomes.base.title')} value={incomeInput} onChange={(event) => onIncomeInputChange(event.target.value)} inputMode="decimal" />
+          </label>
+          <button className="ghost" data-sound="none" onClick={onSaveIncome}><Icon name="check" size={16} />{t('form.income.saveIncome')}</button>
+        </FieldGroup>
+
+        <article className="field-group income-form">
+          <h2>{t('incomes.form.title')}</h2>
+          <form
+            className="field-grid"
+            onSubmit={(event) => {
+              event.preventDefault();
+              void submit();
+            }}
+          >
+            <div className="segmented" role="radiogroup" aria-label={t('incomes.form.type')}>
+              <button type="button" role="radio" aria-checked={form.frequency === 'once'} className={form.frequency === 'once' ? 'active' : ''} onClick={() => setForm({ ...form, frequency: 'once' })}>
+                <Icon name="sparkles" size={15} />{t('incomes.type.once')}
+              </button>
+              <button type="button" role="radio" aria-checked={form.frequency === 'monthly'} className={form.frequency === 'monthly' ? 'active' : ''} onClick={() => setForm({ ...form, frequency: 'monthly' })}>
+                <Icon name="repeat" size={15} />{t('incomes.type.monthly')}
+              </button>
+            </div>
+            <p className="field-note">{t(form.frequency === 'once' ? 'incomes.note.once' : 'incomes.note.monthly')}</p>
+            <label>
+              {t('incomes.form.name')}
+              <input value={form.name} onChange={(event) => setForm({ ...form, name: event.target.value })} />
+            </label>
+            <label>
+              {t('incomes.form.amount')}
+              <input value={form.amount} onChange={(event) => setForm({ ...form, amount: event.target.value })} inputMode="decimal" placeholder="0,00" />
+            </label>
+            <label>
+              {t('incomes.form.category')}
+              <select value={form.category} onChange={(event) => setForm({ ...form, category: event.target.value })}>
+                <option value="">{t('incomes.form.categoryNone')}</option>
+                {categories.map((category) => <option key={category} value={category}>{category}</option>)}
+              </select>
+            </label>
+            {form.frequency === 'once' ? (
+              <label>
+                {t('incomes.form.date')}
+                <input type="date" value={form.date} onChange={(event) => setForm({ ...form, date: event.target.value })} />
+              </label>
+            ) : (
+              <label>
+                {t('incomes.form.day')}
+                <input value={form.dayOfMonth} onChange={(event) => setForm({ ...form, dayOfMonth: event.target.value })} inputMode="numeric" placeholder="1 – 31" />
+              </label>
+            )}
+            {formError ? <p className="form-error" role="alert">{formError}</p> : null}
+            <button type="submit" data-sound="none"><Icon name="plus" size={16} />{t('incomes.form.submit')}</button>
+          </form>
+        </article>
+      </section>
+
+      <section className="lists-grid">
+        <ListCard
+          title={t('incomes.list.recurring.title')}
+          subtitle={t('incomes.list.recurring.subtitle')}
+          language={language}
+          items={recurring.map((income) => ({
+            id: income.id,
+            name: income.name,
+            category: income.category,
+            amountLabel: `+${formatMoney(income.amount, language)}`,
+            active: income.active,
+            detail: income.dayOfMonth ? t('incomes.detail.day', { day: String(income.dayOfMonth) }) : t('incomes.detail.everyMonth'),
+          }))}
+          onToggle={(id, active) => void actions.toggleIncome(id, active)}
+          onDelete={(id) => void actions.deleteIncome(id)}
+          empty={{ icon: 'repeat', title: t('incomes.empty.recurring.title'), body: t('incomes.empty.recurring.body') }}
+        />
+        <ListCard
+          title={t('incomes.list.once.title')}
+          subtitle={t('incomes.list.once.subtitle', { month: monthKey })}
+          language={language}
+          items={oneOff.map((income) => ({
+            id: income.id,
+            name: income.name,
+            category: income.category,
+            amountLabel: `+${formatMoney(income.amount, language)}`,
+            detail: income.date ? formatDate(income.date, language) : undefined,
+          }))}
+          onDelete={(id) => void actions.deleteIncome(id)}
+          empty={{ icon: 'sparkles', title: t('incomes.empty.once.title'), body: t('incomes.empty.once.body') }}
+        />
+      </section>
+    </>
+  );
+}
