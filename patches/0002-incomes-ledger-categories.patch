+    expect(history.map((month) => month.monthKey)).toEqual(['2026-01', '2026-02', '2026-03']);
+    expect(history[1]).toMatchObject({ totalIn: 2700, totalOut: 990, balance: 1710 });
+    expect(history[2]).toMatchObject({ totalIn: 2550, totalOut: 950 });
+  });
+
+  it('shifts month keys across years', () => {
