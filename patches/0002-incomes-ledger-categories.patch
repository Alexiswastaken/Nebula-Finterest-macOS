+describe('category breakdown', () => {
+  it('groups money in and out by category, largest first, without regard to case', () => {
+    const breakdown = categoryBreakdown(sample(), '2026-02');
+    expect(breakdown.out.map((item) => [item.category, item.amount, item.count])).toEqual([
+      ['Logement', 700, 1],
+      [LOAN_CATEGORY, 150, 1],
+      ['Courses', 100, 2],
+      ['Assurance', 40, 1],
+    ]);
+    expect(breakdown.in.map((item) => [item.category, item.amount])).toEqual([[BASE_INCOME_CATEGORY, 2000], ['Loyers', 400], ['Prime', 300]]);
+    expect(breakdown.totalOut).toBe(990);
+    expect(breakdown.out.reduce((sum, item) => sum + item.share, 0)).toBeCloseTo(1);
