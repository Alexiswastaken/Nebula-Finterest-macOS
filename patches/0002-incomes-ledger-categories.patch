+  });
+
+  it('builds a running balance that leaves forecast purchases out', () => {
+    const ledger = getLedger(sample(), '2026-02');
+    expect(ledger.map((entry) => entry.balance)).toEqual([2000, 1960, 1810, 1110, 1410, 1330, 1330, 1310, 1710]);
+    expect(ledger.find((entry) => entry.key === 'purchase-v3')).toMatchObject({ forecast: true, budgetName: 'Voyage' });
+    expect(ledgerTotals(ledger)).toEqual({ totalIn: 2700, totalOut: 990, balance: 1710 });
