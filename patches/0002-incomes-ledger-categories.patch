+
+function sample(): BudgetSnapshot {
+  const snapshot = createEmptySnapshot();
+  snapshot.settings = { income: 2000, activeMonthKey: '2026-02' };
+  snapshot.incomes = [
+    { id: 'i1', name: 'Loyer perçu', amount: 400, category: 'Loyers', frequency: 'monthly', dayOfMonth: 31, date: null, active: true },
+    { id: 'i2', name: 'Prime', amount: 300, category: 'Prime', frequency: 'once', dayOfMonth: null, date: '2026-02-10', active: true },
+    { id: 'i3', name: 'Vente vélo', amount: 150, category: 'Vente', frequency: 'once', dayOfMonth: null, date: '2026-03-02', active: true },
+    { id: 'i4', name: 'Ancienne aide', amount: 90, category: 'Aides', frequency: 'monthly', dayOfMonth: 5, date: null, active: false },
+  ];
+  snapshot.fixedExpenses = [
+    { id: 'f1', name: 'Loyer', amount: 700, category: 'Logement', dayOfMonth: 3, active: true, kind: 'directDebit' },
+    { id: 'f2', name: 'Assurance', amount: 40, category: 'Assurance', dayOfMonth: null, active: true, kind: 'directDebit' },
+    { id: 'f3', name: 'Salle', amount: 30, category: 'Sport', dayOfMonth: 10, active: false, kind: 'subscription' },
+  ];
+  snapshot.budgets = [
+    { id: 'b1', name: 'Voyage', scale: 'project', parentId: null, amount: 1000, period: 'open', startDate: null, endDate: null, countsInMonth: false },
+  ];
+  snapshot.variableExpenses = [
+    { id: 'v1', name: 'Courses', amount: 80, category: 'Courses', date: '2026-02-10', monthKey: '2026-02', budgetId: null },
+    { id: 'v2', name: 'Marché', amount: 20, category: 'courses ', date: '2026-02-14', monthKey: '2026-02', budgetId: null },
+    { id: 'v3', name: 'Billets', amount: 500, category: 'Voyage', date: '2026-02-12', monthKey: '2026-02', budgetId: 'b1' },
+    { id: 'v4', name: 'Cadeau', amount: 60, category: '', date: '2026-03-01', monthKey: '2026-03', budgetId: null },
+  ];
+  snapshot.loans = [
+    { id: 'l1', name: 'Auto', principal: 5000, monthlyPayment: 150, interestRate: 2, remainingMonths: 20, active: true },
+    { id: 'l2', name: 'Soldé', principal: 1000, monthlyPayment: 50, interestRate: 0, remainingMonths: 0, active: false },
+  ];
