diff --git a/src/renderer/components/CategoriesPanel.tsx b/src/renderer/components/CategoriesPanel.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..0b2c8b7c0747d1ed09a09334950c61f2758e6fef
--- /dev/null
+++ b/src/renderer/components/CategoriesPanel.tsx
@@ -0,0 +1,186 @@
+import { useMemo, useState, type CSSProperties } from 'react';
+import type { BudgetSnapshot, CategoryKind } from '@shared/types';
+import { categoryBreakdown, monthlyHistory, type CategoryTotal } from '@shared/cashflow';
+import { amountTone } from '@shared/budgets';
+import { MAX_CATEGORY_NAME } from '@shared/budget';
+import type { Language, TranslationKey } from '../i18n';
+import { translate } from '../i18n';
+import { categoryIcon, categoryLabel, effectiveCategories, formatMoney } from '../constants';
+import { Icon } from './Icon';
+
+export type CategoryList = Array<{ id?: string; name: string; kind: CategoryKind }>;
+
+/**
+ * "Catégories": the month's money in and out grouped by category, the last twelve months side by
+ * side, and the list of categories offered in the forms, which the user can extend and prune.
+ */
+export function CategoriesPanel({ snapshot, monthKey, language, onMonthChange, onSaveCategories }: {
+  snapshot: BudgetSnapshot;
+  monthKey: string;
+  language: Language;
+  onMonthChange: (monthKey: string) => void;
+  /** Saves the whole list; resolves to false when it was refused. */
+  onSaveCategories: (categories: CategoryList) => Promise<boolean>;
+}) {
+  const t = (key: TranslationKey, params?: Record<string, string>) => translate(language, key, params);
+  const locale = language === 'en' ? 'en-US' : 'fr-FR';
+  const breakdown = useMemo(() => categoryBreakdown(snapshot, monthKey), [snapshot, monthKey]);
+  const history = useMemo(() => monthlyHistory(snapshot, monthKey, 12), [snapshot, monthKey]);
+  const categories = effectiveCategories(snapshot, language);
+  const [name, setName] = useState('');
+  const [kind, setKind] = useState<CategoryKind>('expense');
+  const [formError, setFormError] = useState<string | null>(null);
+
+  const monthLabel = (key: string) => {
+    const [year, month] = key.split('-').map(Number);
+    const label = new Date(year, month - 1, 1).toLocaleDateString(locale, { month: 'long', year: 'numeric' });
+    return label.charAt(0).toUpperCase() + label.slice(1);
+  };
+
+  async function addCategory(): Promise<void> {
+    const trimmed = name.trim();
+    if (!trimmed || trimmed.length > MAX_CATEGORY_NAME) {
+      setFormError(t('error.invalidCategory'));
+      return;
+    }
+    if (categories.some((category) => category.kind === kind && category.name.toLocaleLowerCase() === trimmed.toLocaleLowerCase())) {
+      setFormError(t('error.duplicateCategory'));
+      return;
+    }
+    setFormError(null);
+    if (await onSaveCategories([...categories, { name: trimmed, kind }])) setName('');
+  }
+
+  const removeCategory = (target: { name: string; kind: CategoryKind }) =>
+    void onSaveCategories(categories.filter((category) => !(category.kind === target.kind && category.name === target.name)));
+
+  const breakdownCard = (titleKey: TranslationKey, emptyKey: TranslationKey, items: CategoryTotal[], total: number, direction: 'in' | 'out') => (
+    <article className="list-card category-card">
+      <div className="list-heading">
+        <div>
+          <h2>{t(titleKey)}</h2>
+          <p>{monthLabel(monthKey)}</p>
+        </div>
+        <strong className={`amount amount-${direction === 'in' ? 'positive' : 'negative'}`}>{direction === 'in' ? '+' : '−'}{formatMoney(total, language)}</strong>
+      </div>
+      {items.length === 0 ? <p className="ledger-hint">{t(emptyKey)}</p> : null}
+      <ul className="category-rows">
+        {items.map((item) => (
+          <li key={item.category.toLocaleLowerCase() || 'none'}>
+            <span className={`list-icon ledger-icon ${direction}`}><Icon name={categoryIcon(item.category, language)} size={18} /></span>
+            <div className="list-text">
+              <strong>{categoryLabel(item.category, language)}</strong>
+              <span>{item.count === 1 ? t('categories.count.one') : t('categories.count.many', { count: String(item.count) })} · {Math.round(item.share * 100)} %</span>
+              <div className={`budget-progress category-bar ${direction}`} aria-hidden="true"><i style={{ '--ratio': String(item.share) } as CSSProperties} /></div>
+            </div>
+            <span className="row-amount amount">{formatMoney(item.amount, language)}</span>
+          </li>
+        ))}
+      </ul>
+    </article>
+  );
+
+  const manageList = (listKind: CategoryKind, titleKey: TranslationKey) => {
+    const items = categories.filter((category) => category.kind === listKind);
+    return (
+      <div className="category-manage-list">
+        <h3>{t(titleKey)}</h3>
+        {items.length === 0 ? <p className="ledger-hint">{t('categories.manage.empty')}</p> : null}
+        <ul className="category-chips">
+          {items.map((category) => (
+            <li key={`${category.kind}-${category.name}`}>
+              <Icon name={categoryIcon(category.name, language)} size={14} />
+              <span>{category.name}</span>
+              <button
+                type="button"
+                className="ghost small icon-button danger"
+                data-sound="none"
+                onClick={() => removeCategory(category)}
+                aria-label={`${t('categories.manage.delete')} ${category.name}`}
+                title={t('categories.manage.delete')}
+              >
+                <Icon name="trash" size={14} />
+              </button>
+            </li>
+          ))}
+        </ul>
+      </div>
+    );
+  };
+
+  return (
+    <>
+      <section className="lists-grid">
+        {breakdownCard('categories.out.title', 'categories.empty.out', breakdown.out, breakdown.totalOut, 'out')}
+        {breakdownCard('categories.in.title', 'categories.empty.in', breakdown.in, breakdown.totalIn, 'in')}
+      </section>
+
+      <section className="list-card history-card">
+        <div className="list-heading">
+          <div>
+            <h2>{t('categories.history.title')}</h2>
+            <p>{t('categories.history.subtitle')}</p>
+          </div>
+        </div>
+        <div className="history-table" role="table">
+          <div className="history-row history-head" role="row">
+            <span role="columnheader">{t('categories.history.month')}</span>
+            <span role="columnheader">{t('ledger.totalIn')}</span>
+            <span role="columnheader">{t('ledger.totalOut')}</span>
+            <span role="columnheader">{t('ledger.balance')}</span>
+          </div>
+          {[...history].reverse().map((item) => (
+            <button
+              key={item.monthKey}
+              type="button"
+              role="row"
+              className={`history-row ${item.monthKey === monthKey ? 'active' : ''}`}
+              data-sound="nav"
+              aria-current={item.monthKey === monthKey ? 'true' : undefined}
+              onClick={() => onMonthChange(item.monthKey)}
+            >
+              <span role="cell">{monthLabel(item.monthKey)}</span>
+              <span role="cell" className="amount amount-positive">+{formatMoney(item.totalIn, language)}</span>
+              <span role="cell" className="amount amount-negative">−{formatMoney(item.totalOut, language)}</span>
+              <span role="cell" className={`amount amount-${amountTone(item.balance)}`}>{formatMoney(item.balance, language)}</span>
+            </button>
+          ))}
+        </div>
+      </section>
+
+      <section className="list-card category-manage">
+        <div className="list-heading">
+          <div>
+            <h2>{t('categories.manage.title')}</h2>
+            <p>{t('categories.manage.hint')}</p>
+          </div>
+        </div>
+        <form
+          className="category-form"
+          onSubmit={(event) => {
+            event.preventDefault();
+            void addCategory();
+          }}
+        >
+          <label>
+            {t('categories.manage.name')}
+            <input value={name} maxLength={MAX_CATEGORY_NAME} onChange={(event) => setName(event.target.value)} />
+          </label>
+          <label>
+            {t('categories.manage.kind')}
+            <select value={kind} onChange={(event) => setKind(event.target.value as CategoryKind)}>
+              <option value="expense">{t('categories.manage.kind.expense')}</option>
+              <option value="income">{t('categories.manage.kind.income')}</option>
+            </select>
+          </label>
+          <button type="submit" data-sound="none"><Icon name="plus" size={16} />{t('categories.manage.add')}</button>
+        </form>
+        {formError ? <p className="form-error" role="alert">{formError}</p> : null}
+        <div className="category-manage-grid">
+          {manageList('expense', 'categories.manage.expense')}
+          {manageList('income', 'categories.manage.income')}
+        </div>
+      </section>
+    </>
+  );
+}
