+      expect(totals.totalOut).toBe(summary.totalExpenses);
+      expect(totals.balance).toBe(summary.remainingIncome);
+    }
+  });
+
+  it('counts incomes in the summary: main, recurring, and one-off of the month', () => {
+    const summary = computeBudgetSummary(sample(), '2026-02');
+    expect(summary).toMatchObject({ income: 2700, baseIncome: 2000, recurringIncome: 400, oneOffIncome: 300 });
+    expect(computeBudgetSummary(sample(), '2026-03').oneOffIncome).toBe(150);
+  });
+
+  it('puts a recurring item of the 31st on the last day of a shorter month, and returns nothing for a bad month', () => {
+    expect(getLedger(sample(), '2026-02').find((entry) => entry.key === 'income-i1')?.day).toBe(28);
+    expect(getLedger(sample(), '2026-03').find((entry) => entry.key === 'income-i1')?.day).toBe(31);
+    expect(getLedger(sample(), 'nope')).toEqual([]);
+  });
