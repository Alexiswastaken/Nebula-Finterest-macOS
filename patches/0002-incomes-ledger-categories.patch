new file mode 100644
index 0000000000000000000000000000000000000000..4bd78878f94510c8b03f15fdd602915f744aac85
--- /dev/null
+++ b/src/renderer/components/LedgerPanel.tsx
@@ -0,0 +1,124 @@
+import { useMemo, useState } from 'react';
+import type { BudgetSnapshot } from '@shared/types';
+import { getLedger, ledgerTotals, type LedgerEntry } from '@shared/cashflow';
+import { amountTone } from '@shared/budgets';
+import type { Language, TranslationKey } from '../i18n';
+import { translate } from '../i18n';
+import { categoryIcon, categoryLabel, formatMoney } from '../constants';
+import { Icon, type IconName } from './Icon';
+import { EmptyState } from './ScreenState';
+
+type Filter = 'all' | 'in' | 'out';
+
+const FILTERS: Array<{ id: Filter; labelKey: TranslationKey }> = [
+  { id: 'all', labelKey: 'ledger.filter.all' },
+  { id: 'in', labelKey: 'ledger.filter.in' },
+  { id: 'out', labelKey: 'ledger.filter.out' },
+];
+
+function entryIcon(entry: LedgerEntry, language: Language): IconName {
+  if (entry.source === 'baseIncome') return 'bank';
+  if (entry.source === 'loan') return 'bank';
+  const icon = categoryIcon(entry.category, language);
+  if (icon !== 'tag') return icon;
+  return entry.direction === 'in' ? 'trendUp' : entry.source === 'fixed' ? 'repeat' : 'bag';
+}
+
+function typeKey(entry: LedgerEntry, snapshot: BudgetSnapshot): TranslationKey {
+  switch (entry.source) {
+    case 'baseIncome':
+      return 'ledger.type.baseIncome';
+    case 'income':
+      return entry.recurring ? 'ledger.type.incomeMonthly' : 'ledger.type.incomeOnce';
+    case 'fixed':
+      return snapshot.fixedExpenses.find((expense) => expense.id === entry.id)?.kind === 'directDebit' ? 'badge.directDebit' : 'badge.subscription';
+    case 'loan':
+      return 'ledger.type.loan';
+    default:
+      return 'ledger.type.purchase';
+  }
+}
+
+/**
+ * "Entrées et sorties": every movement of the month, one after the other in date order, with the
+ * month's balance as it builds up. Read-only: each item is edited on its own screen.
+ */
+export function LedgerPanel({ snapshot, monthKey, language }: { snapshot: BudgetSnapshot; monthKey: string; language: Language }) {
+  const t = (key: TranslationKey, params?: Record<string, string>) => translate(language, key, params);
+  const locale = language === 'en' ? 'en-US' : 'fr-FR';
+  const [filter, setFilter] = useState<Filter>('all');
+  const entries = useMemo(() => getLedger(snapshot, monthKey), [snapshot, monthKey]);
+  const totals = useMemo(() => ledgerTotals(entries), [entries]);
+  const shown = filter === 'all' ? entries : entries.filter((entry) => entry.direction === filter);
+  const [year, month] = monthKey.split('-').map(Number);
+
+  // Consecutive entries of the same day share one heading.
+  const groups: Array<{ day: number | null; entries: LedgerEntry[] }> = [];
+  for (const entry of shown) {
+    const last = groups[groups.length - 1];
+    if (last && last.day === entry.day) last.entries.push(entry);
+    else groups.push({ day: entry.day, entries: [entry] });
+  }
+
+  const dayLabel = (day: number | null) => {
+    if (day === null) return t('ledger.undated');
+    const label = new Date(year, month - 1, day).toLocaleDateString(locale, { weekday: 'long', day: 'numeric', month: 'long' });
+    return label.charAt(0).toUpperCase() + label.slice(1);
+  };
+
+  return (
+    <section className="list-card ledger-panel">
+      <div className="ledger-toolbar">
+        <p className="ledger-hint">{t('ledger.hint')}</p>
+        <div className="segmented segmented-quiet" role="radiogroup" aria-label={t('ledger.filter.label')}>
+          {FILTERS.map((item) => (
+            <button key={item.id} type="button" role="radio" aria-checked={filter === item.id} className={filter === item.id ? 'active' : ''} data-sound="toggle" onClick={() => setFilter(item.id)}>
+              {t(item.labelKey)}
+            </button>
+          ))}
+        </div>
+      </div>
+
+      <div className="calendar-totals">
+        <span className="calendar-legend"><Icon name="trendUp" size={15} />{t('ledger.totalIn')} <b className="amount amount-positive">+{formatMoney(totals.totalIn, language)}</b></span>
+        <span className="calendar-legend"><Icon name="bag" size={15} />{t('ledger.totalOut')} <b className="amount amount-negative">−{formatMoney(totals.totalOut, language)}</b></span>
+        <span className="calendar-legend total">{t('ledger.balance')} <b className={`amount amount-${amountTone(totals.balance)}`}>{formatMoney(totals.balance, language)}</b></span>
+      </div>
+
+      {entries.length === 0 ? <EmptyState compact icon="history" title={t('ledger.empty.title')} body={t('ledger.empty.body')} /> : null}
+      {entries.length > 0 && shown.length === 0 ? <p className="ledger-hint">{t('ledger.empty.filtered')}</p> : null}
+
+      {groups.map((group) => (
+        <div key={group.day ?? 'undated'} className="ledger-day">
+          <h3>{dayLabel(group.day)}</h3>
+          <ul>
+            {group.entries.map((entry) => {
+              const name = entry.source === 'baseIncome' ? t('ledger.baseIncome') : entry.name;
+              const meta = [
+                t(typeKey(entry, snapshot)),
+                entry.source === 'baseIncome' || entry.source === 'loan' ? null : categoryLabel(entry.category, language),
+                entry.budgetName ?? null,
+                entry.forecast ? t('budgets.forecast') : null,
+              ].filter(Boolean).join(' · ');
+              return (
+                <li key={entry.key} className={entry.forecast ? 'inactive' : undefined}>
+                  <span className={`list-icon ledger-icon ${entry.direction}`}><Icon name={entryIcon(entry, language)} size={18} /></span>
+                  <div className="list-text">
+                    <strong>{name}</strong>
+                    <span>{meta}</span>
+                  </div>
+                  <div className="row-actions ledger-amounts">
+                    <span className={`row-amount amount amount-${entry.direction === 'in' ? 'positive' : 'negative'}`}>
+                      {entry.direction === 'in' ? '+' : '−'}{formatMoney(entry.amount, language)}
+                    </span>
+                    {filter === 'all' && !entry.forecast ? <small className="ledger-balance">{t('ledger.runningBalance', { amount: formatMoney(entry.balance, language) })}</small> : null}
+                  </div>
+                </li>
+              );
+            })}
+          </ul>
+        </div>
+      ))}
+    </section>
+  );
+}
