+  it('has no main-income line when the main income is zero', () => {
+    const snapshot = sample();
+    snapshot.settings.income = 0;
+    expect(getLedger(snapshot, '2026-02').some((entry) => entry.source === 'baseIncome')).toBe(false);
+  });
+});
