+
+describe('ledger', () => {
+  it('lists the month in date order: no day first, money in before money out on the same day', () => {
+    const ledger = getLedger(sample(), '2026-02');
+    expect(ledger.map((entry) => entry.key)).toEqual([
+      'base-income', 'fixed-f2', 'loan-l1', 'fixed-f1', 'income-i2', 'purchase-v1', 'purchase-v3', 'purchase-v2', 'income-i1',
