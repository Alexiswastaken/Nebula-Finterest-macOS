new file mode 100644
index 0000000000000000000000000000000000000000..d207102d0adacbe34179acf52647cdb1576da88a
--- /dev/null
+++ b/src/shared/cashflow.ts
@@ -0,0 +1,179 @@
+import type { BudgetSnapshot } from './types';
+import { daysInMonth, isValidDateString, isValidMonthKey } from './budget';
+import { countsInMonth } from './budgets';
+
+/**
+ * Money in and money out, seen three ways: one after the other by date (`getLedger`), grouped by
+ * category (`categoryBreakdown`), and month after month (`monthlyHistory`). Pure functions over a
+ * snapshot, following the same rules as `computeBudgetSummary` so every screen agrees:
+ * recurring charges, loans and recurring incomes belong to every month; purchases and one-off
+ * incomes to the month of their date; a purchase charged to a forecast budget is shown but never
+ * counted.
+ */
+export type LedgerSource = 'baseIncome' | 'income' | 'fixed' | 'purchase' | 'loan';
+
+export interface LedgerEntry {
+  /** Unique in a ledger: the same id may exist in two tables. */
+  key: string;
+  id: string;
+  source: LedgerSource;
+  direction: 'in' | 'out';
+  name: string;
+  category: string;
+  /** Always positive; `direction` tells the sign. */
+  amount: number;
+  /** Day of the month, or null when the item has no known day (a loan, the main income). */
+  day: number | null;
+  /** Comes back every month. */
+  recurring: boolean;
+  /** Charged to a forecast budget: listed, left out of the totals and of the running balance. */
+  forecast?: boolean;
+  budgetName?: string;
+  /** Balance of the month after this entry (entries without a day first, then day by day). */
+  balance: number;
+}
+
+/** The category of loan payments and of the main income, which have none of their own. */
+export const LOAN_CATEGORY = '__loans__';
+export const BASE_INCOME_CATEGORY = '__base_income__';
+
+const clampDay = (day: number, lastDay: number) => Math.min(Math.max(1, day), lastDay);
+
+/**
+ * Every movement of `monthKey` in date order: first what has no day, then day by day, money in
+ * before money out on the same day. A recurring item set on the 29th-31st lands on the last day of
+ * a shorter month, like in the calendar.
+ */
+export function getLedger(snapshot: BudgetSnapshot, monthKey: string): LedgerEntry[] {
+  if (!isValidMonthKey(monthKey)) return [];
+  const lastDay = daysInMonth(monthKey);
+  const budgets = snapshot.budgets ?? [];
+  const entries: Array<Omit<LedgerEntry, 'balance'>> = [];
+
+  if (snapshot.settings.income > 0) {
+    entries.push({ key: 'base-income', id: 'base-income', source: 'baseIncome', direction: 'in', name: '', category: BASE_INCOME_CATEGORY, amount: snapshot.settings.income, day: null, recurring: true });
+  }
+  for (const income of snapshot.incomes ?? []) {
+    if (!income.active) continue;
+    if (income.frequency === 'monthly') {
+      entries.push({ key: `income-${income.id}`, id: income.id, source: 'income', direction: 'in', name: income.name, category: income.category, amount: income.amount, day: income.dayOfMonth === null ? null : clampDay(income.dayOfMonth, lastDay), recurring: true });
+    } else if (isValidDateString(income.date) && income.date.slice(0, 7) === monthKey) {
+      entries.push({ key: `income-${income.id}`, id: income.id, source: 'income', direction: 'in', name: income.name, category: income.category, amount: income.amount, day: Number(income.date.slice(8, 10)), recurring: false });
+    }
+  }
+  for (const expense of snapshot.fixedExpenses) {
+    if (!expense.active) continue;
+    entries.push({ key: `fixed-${expense.id}`, id: expense.id, source: 'fixed', direction: 'out', name: expense.name, category: expense.category, amount: expense.amount, day: expense.dayOfMonth === null ? null : clampDay(expense.dayOfMonth, lastDay), recurring: true });
+  }
+  for (const expense of snapshot.variableExpenses) {
+    if (expense.monthKey !== monthKey) continue;
+    const budget = expense.budgetId ? budgets.find((candidate) => candidate.id === expense.budgetId) : undefined;
+    entries.push({
+      key: `purchase-${expense.id}`,
+      id: expense.id,
+      source: 'purchase',
+      direction: 'out',
+      name: expense.name,
+      category: expense.category,
+      amount: expense.amount,
+      day: isValidDateString(expense.date) && expense.date.slice(0, 7) === monthKey ? Number(expense.date.slice(8, 10)) : null,
+      recurring: false,
+      ...(countsInMonth(expense, budgets) ? {} : { forecast: true }),
+      ...(budget ? { budgetName: budget.name } : {}),
+    });
+  }
+  for (const loan of snapshot.loans ?? []) {
+    if (!loan.active) continue;
+    entries.push({ key: `loan-${loan.id}`, id: loan.id, source: 'loan', direction: 'out', name: loan.name, category: LOAN_CATEGORY, amount: loan.monthlyPayment, day: null, recurring: true });
+  }
+
+  // Stable sort: no day first, then by day, incomes before expenses, then as listed.
+  const order = (entry: Omit<LedgerEntry, 'balance'>) => (entry.day ?? 0) * 2 + (entry.direction === 'in' ? 0 : 1);
+  const sorted = entries.map((entry, index) => ({ entry, index })).sort((a, b) => order(a.entry) - order(b.entry) || a.index - b.index);
+
+  let balance = 0;
+  return sorted.map(({ entry }) => {
+    if (!entry.forecast) balance += entry.direction === 'in' ? entry.amount : -entry.amount;
+    return { ...entry, balance };
+  });
+}
+
+export interface LedgerTotals {
+  totalIn: number;
+  totalOut: number;
+  balance: number;
+}
+
+/** Totals of a ledger, forecast purchases left out. */
+export function ledgerTotals(entries: readonly LedgerEntry[]): LedgerTotals {
+  let totalIn = 0;
+  let totalOut = 0;
+  for (const entry of entries) {
+    if (entry.forecast) continue;
+    if (entry.direction === 'in') totalIn += entry.amount;
+    else totalOut += entry.amount;
+  }
+  return { totalIn, totalOut, balance: totalIn - totalOut };
+}
+
+export interface CategoryTotal {
+  /** The category name as stored on the items; '' when none; or one of the two special keys above. */
+  category: string;
+  amount: number;
+  count: number;
+  /** Part of the direction's total, from 0 to 1. */
+  share: number;
+}
+
+export interface CategoryBreakdown extends LedgerTotals {
+  in: CategoryTotal[];
+  out: CategoryTotal[];
+}
+
+/**
+ * The month's money in and out grouped by category, largest first. Names are grouped without
+ * regard to case or surrounding spaces ("Courses" and "courses " are one category); the first
+ * spelling met is the one shown.
+ */
+export function categoryBreakdown(snapshot: BudgetSnapshot, monthKey: string): CategoryBreakdown {
+  const entries = getLedger(snapshot, monthKey).filter((entry) => !entry.forecast);
+  const totals = ledgerTotals(entries);
+  const group = (direction: 'in' | 'out', total: number): CategoryTotal[] => {
+    const groups = new Map<string, CategoryTotal>();
+    for (const entry of entries) {
+      if (entry.direction !== direction) continue;
+      const name = entry.category.trim();
+      const key = name.toLocaleLowerCase();
+      const current = groups.get(key) ?? { category: name, amount: 0, count: 0, share: 0 };
+      current.amount += entry.amount;
+      current.count += 1;
+      groups.set(key, current);
+    }
+    return [...groups.values()]
+      .map((item) => ({ ...item, share: total > 0 ? item.amount / total : 0 }))
+      .sort((a, b) => b.amount - a.amount || a.category.localeCompare(b.category));
+  };
+  return { ...totals, in: group('in', totals.totalIn), out: group('out', totals.totalOut) };
+}
+
+export interface MonthTotals extends LedgerTotals {
+  monthKey: string;
+}
+
+/** `monthKey` shifted by `offset` months. */
+export function shiftMonthKey(monthKey: string, offset: number): string {
+  const [year, month] = monthKey.split('-').map(Number);
+  const date = new Date(year, month - 1 + offset, 1);
+  return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}`;
+}
+
+/** The `count` months ending with `monthKey`, oldest first, with their totals. */
+export function monthlyHistory(snapshot: BudgetSnapshot, monthKey: string, count = 12): MonthTotals[] {
+  if (!isValidMonthKey(monthKey)) return [];
+  const months: MonthTotals[] = [];
+  for (let offset = -(count - 1); offset <= 0; offset += 1) {
+    const key = shiftMonthKey(monthKey, offset);
+    months.push({ monthKey: key, ...ledgerTotals(getLedger(snapshot, key)) });
+  }
+  return months;
+}
