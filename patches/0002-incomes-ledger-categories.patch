+    expect(march.out.find((item) => item.category === '')).toMatchObject({ amount: 60, count: 1 });
+    const empty = categoryBreakdown(createEmptySnapshot(), '2026-03');
+    expect(empty).toMatchObject({ totalIn: 0, totalOut: 0, in: [], out: [] });
+  });
+});
